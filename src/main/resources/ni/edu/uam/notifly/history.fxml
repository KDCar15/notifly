<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label text="Criterios de búsqueda">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <GridPane hgap="15.0" vgap="15.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="-Infinity" prefWidth="50.0" />
          <ColumnConstraints hgrow="SOMETIMES" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="-Infinity" prefWidth="50.0" />
            <ColumnConstraints hgrow="SOMETIMES" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Tipo" />
            <ComboBox fx:id="cb_tipo" prefHeight="24.0" prefWidth="300.0" GridPane.columnIndex="1" />
            <ComboBox fx:id="cb_categoria" prefHeight="24.0" prefWidth="300.0" GridPane.columnIndex="3" />
            <Label text="Categoría" GridPane.columnIndex="2" />
            <Label text="Desde la fecha" GridPane.rowIndex="3" />
            <Button fx:id="bt_fecha" mnemonicParsing="false" onAction="#seleccionar_fecha_inicio" prefWidth="300.0" text="Seleccionar fecha" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Button mnemonicParsing="false" onAction="#seleccionar_fecha_fin" prefWidth="300.0" text="Seleccionar fecha" GridPane.columnIndex="3" GridPane.rowIndex="3" />
            <Label text="Hasta la fecha" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <Label text="Estado" GridPane.rowIndex="1" />
            <Label text="Facultad" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <ComboBox fx:id="cb_estado" prefHeight="24.0" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <ComboBox fx:id="cb_facultad" prefWidth="300.0" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            <ComboBox fx:id="cb_area" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Área involucrada" GridPane.rowIndex="2" />
         </children>
      </GridPane>
      <HBox alignment="TOP_RIGHT" prefHeight="0.0" prefWidth="600.0" spacing="15.0">
         <children>
            <Button mnemonicParsing="false" onAction="#buscar" text="Buscar" />
            <Button mnemonicParsing="false" onAction="#limpiar" text="Limpiar" />
            <Button mnemonicParsing="false" onAction="#visualizar" text="Visualizar" />
         </children>
      </HBox>
      <Label text="Resultados">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TableView fx:id="tv_resultados" prefHeight="346.0" prefWidth="570.0">
        <columns>
          <TableColumn prefWidth="120.0" text="Último acceso" />
            <TableColumn prefWidth="60.0" text="No." />
            <TableColumn prefWidth="120.0" text="Tipo" />
          <TableColumn prefWidth="120.0" text="Facultad" />
            <TableColumn minWidth="1.0" prefWidth="120.0" text="Categoría" />
            <TableColumn prefWidth="120.0" text="Área" />
            <TableColumn prefWidth="120.0" text="Estado" />
        </columns>
      </TableView>
   </children>
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
</VBox>
